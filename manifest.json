{
  "manifest_version": 3,
  "name": "Auto Copy Selection",
  "version": "1.0.0",
  "description": "Streamline your copy-paste workflow with automatic text copying and intuitive hold-to-paste gestures",
  "homepage_url": "https://github.com/that-guy-scott/copy-paste-extension",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Copy Selection"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
